-- Services
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")

-- Locals
local LocalPlayer     = Players.LocalPlayer
local GameData        = ReplicatedStorage:WaitForChild("GameData")
local CurrentRooms    = Workspace:WaitForChild("CurrentRooms")
local RemotesFolder   = ReplicatedStorage:WaitForChild("RemotesFolder")
local PlayAgainRemote = RemotesFolder:WaitForChild("PlayAgain")

-- State
local running, hrp, humanoid, rushFound = true, nil, nil, false

-- GUI STOP BUTTON
local gui = Instance.new("ScreenGui", game:GetService("CoreGui"))
gui.Name = "KnobFarmGui"
local stopBtn = Instance.new("TextButton", gui)
stopBtn.Size = UDim2.new(0,150,0,50)
stopBtn.Position = UDim2.new(0,10,0,10)
stopBtn.BackgroundColor3 = Color3.fromRGB(255,64,64)
stopBtn.Font = Enum.Font.SourceSansBold
stopBtn.TextScaled = true
stopBtn.Text = "Stop KnobFarm"
stopBtn.MouseButton1Click:Connect(function()
    running = false
    gui:Destroy()
end)

-- BFS finder under a root for a Model named targetName
local function bfsFindModel(root, targetName)
    local queue = { root }
    local idx = 1
    while idx <= #queue do
        local node = queue[idx]
        idx += 1
        if node:IsA("Model") and node.Name == targetName then
            return node
        end
        for _, child in ipairs(node:GetChildren()) do
            queue[#queue+1] = child
        end
    end
    return nil
end

-- BFS finder under a root for a ProximityPrompt
local function bfsFindPrompt(root)
    local queue = { root }
    local idx = 1
    while idx <= #queue do
        local node = queue[idx]
        idx += 1
        if node:IsA("ProximityPrompt") then
            return node
        end
        for _, child in ipairs(node:GetChildren()) do
            queue[#queue+1] = child
        end
    end
    return nil
end

-- Fire a prompt with custom helper
local function firePrompt(prompt)
    if not prompt then return end
    prompt:InputHoldBegin()
    task.wait(prompt.HoldDuration or 0)
    prompt:InputHoldEnd()
end

-- Teleport HRP to part
local function teleportTo(part)
    if hrp and part and part:IsA("BasePart") then
        hrp.CFrame = part.CFrame + Vector3.new(0,3,0)
    end
end

-- Check if player has Key
local function hasKey()
    local c = LocalPlayer.Character
    return (c and c:FindFirstChild("Key")) or LocalPlayer.Backpack:FindFirstChild("Key")
end

-- Refresh hrp & humanoid on respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    hrp = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")
    humanoid.Died:Connect(function()
        PlayAgainRemote:FireServer()
    end)
end)
if LocalPlayer.Character then
    local char = LocalPlayer.Character
    hrp = char:WaitForChild("HumanoidRootPart")
    humanoid = char:WaitForChild("Humanoid")
    humanoid.Died:Connect(function()
        PlayAgainRemote:FireServer()
    end)
end

-- Watch for RushMoving spawn and teleport immediately
Workspace.ChildAdded:Connect(function(child)
    if not running then return end
    if child:IsA("Model") and child.Name == "RushMoving" then
        rushFound = true
        local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
        teleportTo(part)
    end
end)

-- Main Heartbeat loop: farm keys and doors only if no RushMoving yet
RunService.Heartbeat:Connect(function()
    if not running or not hrp or rushFound then return end

    local room = CurrentRooms:FindFirstChild(tostring(GameData.LatestRoom.Value))
    if not room then return end

    if not hasKey() then
        local keyModel = bfsFindModel(room, "KeyObtain")
        if keyModel and keyModel.PrimaryPart then
            local prompt = bfsFindPrompt(keyModel)
            firePrompt(prompt)
            teleportTo(keyModel.PrimaryPart)
        end
    else
        local doorModel = bfsFindModel(room, "Door")
        if doorModel then
            local doorPart = doorModel:FindFirstChild("Door") or doorModel.PrimaryPart
            local prompt   = bfsFindPrompt(doorModel)
            firePrompt(prompt)
            teleportTo(doorPart)
        end
    end
end)
