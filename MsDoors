-- VALIDATION: should we auto-interact this prompt?
--––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
local function isValidPrompt(prompt)
    if not prompt or not prompt.Parent then
        return false
    end
    if ignoreSet[prompt.Name] then
        return false
    end
    if ignoredParents[prompt.Parent.Name] then
        return false
    end
    return getPromptPart(prompt) ~= nil
end

