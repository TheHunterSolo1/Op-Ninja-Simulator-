local function getLockerPart()
	-- Returns the closest locker PrimaryPart under workspace.CurrentRooms,
	-- provided it has a HidePrompt and isn't already hiding someone.
	local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		if DebugToggle.Value then
			throttleNotify("getLockerPart: HRP not found", 2)
		end
		return
	end

	local closestPart, minDist = nil, math.huge
	for _, obj in ipairs(workspace.CurrentRooms:GetDescendants()) do
		-- Look for any Model that has a HidePrompt and a PrimaryPart set
		if obj:IsA("Model") and obj:FindFirstChild("HidePrompt") and obj.PrimaryPart and obj:FindFirstChild("HiddenPlayer") then
			-- If the locker is not already occupied (no HiddenPlayer attribute)
			if obj.HiddenPlayer == nil then
				local d = (root.Position - obj.PrimaryPart.Position).Magnitude
				if d < minDist then
					closestPart, minDist = obj.PrimaryPart, d
				end
			end
		end
	end

	if not closestPart and DebugToggle.Value then
		throttleNotify("Locker part not found!", 2)
	end
	return closestPart
end

local function getDoorPart()
	local roomModel = workspace.CurrentRooms:FindFirstChild(LatestRoom.Value)
	if roomModel then
		local doorModel = roomModel:FindFirstChild("Door")
		if doorModel then
			return doorModel:FindFirstChild("Door")
		end
	end
	if DebugToggle.Value then
		throttleNotify("getDoorPart: door not found in room ".. tostring(LatestRoom.Value), 2)
	end
end

local waypoints, index, hiding = {}, 1, false

local function computePath(destPart)
	if not destPart or not AutoRoomsToggle.Value then
		-- either there's no destination or the toggle is off
		return
	end

	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if DebugToggle.Value then
			throttleNotify("computePath: HRP missing", 2)
		end
		return
	end

	local origin = hrp.Position - Vector3.new(0, 2.5, 0)
	local path = PathfindingService:CreatePath{
		WaypointSpacing = WaypointSpacingSlider.Value,
		AgentRadius     = 1.2,
		AgentCanJump    = false,
	}
	path:ComputeAsync(origin, destPart.Position)

	if path.Status ~= Enum.PathStatus.Success then
		if DebugToggle.Value then
			throttleNotify("Path failed: ".. tostring(path.Status), 2)
		end
		return
	end

	-- Visualize & store waypoints
	local wps = path:GetWaypoints()
	waypoints, index = wps, 1
	for i, wp in ipairs(wps) do
		local part = visuals[i] or Instance.new("Part", folder)
		visuals[i] = part
		part.Size       = Vector3.new(2, 2, 2)
		part.Shape      = Enum.PartType.Ball
		part.Material   = Enum.Material.SmoothPlastic
		part.Anchored   = true
		part.CanCollide = false
		part.CFrame     = CFrame.new(wp.Position)
	end
	-- Remove any extra visuals from a previous path
	for i = #wps + 1, #visuals do
		visuals[i].Parent = nil
	end

	if #wps > 0 then
		LocalPlayer.Character.Humanoid:MoveTo(wps[1].Position)
	end
end

local function onMoveFinished(reached)
	if not reached then
		if DebugToggle.Value then
			throttleNotify("Stuck, recalculating...", 1)
		end
		-- Retry pathing to whichever part we were aiming for
		return computePath(hiding and getLockerPart() or getDoorPart())
	end

	index = index + 1
	if index <= #waypoints then
		LocalPlayer.Character.Humanoid:MoveTo(waypoints[index].Position)
	else
		if hiding then
			-- We have reached the locker area; actually fire the prompt
			local lockerModel = getLockerPart() and getLockerPart().Parent
			if lockerModel and lockerModel:FindFirstChild("HidePrompt") then
				fireproximityprompt(lockerModel.HidePrompt)
				LocalPlayer.Character:SetAttribute("Hiding", true)
				if DebugToggle.Value then
					throttleNotify("Hiding in locker!", 2)
				end
			else
				if DebugToggle.Value then
					throttleNotify("Couldn’t find HidePrompt to fire!", 2)
				end
			end
		else
			-- We have reached the door
			if tonumber(LatestRoom.Value) == 1000 then
				throttleNotify("Congratulations on A-1000!", 5)
			end
			if DebugToggle.Value then
				throttleNotify("Reached door", 1)
			end
		end
	end
end

