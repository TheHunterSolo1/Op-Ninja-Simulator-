local autoRoomsLoop
AutoRoomsToggle:OnChanged(function(on)
	-- Clear visuals & reset state whenever we toggle on/off
	waypoints, index, hiding = {}, 1, false
	for _, p in ipairs(visuals) do
		p.Parent = nil
	end

	if on then
		-- Do an initial path attempt (to the current door)
		computePath(getDoorPart())
		updateBehavior()
		-- Start a short loop that continually re-validates our destination
		autoRoomsLoop = task.spawn(function()
			while AutoRoomsToggle.Value do
				computePath(hiding and getLockerPart() or getDoorPart())
				task.wait(1)
			end
		end)
	else
		-- Stop the loop
		autoRoomsLoop = nil
	end
end)
