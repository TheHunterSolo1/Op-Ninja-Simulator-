-- ───────────── Player ESP (Health) ─────────────
do
    local function makePlayerESP(toggleName, labelFn, color)
        local tracked = {}    -- [BasePart] = true
        local conns   = {}    -- list of connections

        -- Add ESP for a single player
        local function addPlayer(player)
            if not player.Character then return end
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local rootPart = player.Character.PrimaryPart
            if not humanoid or not rootPart then return end

            -- Update or create ESP for this player
            local function updateESP()
                local label = labelFn(player, humanoid)
                ESPLibrary:AddESP({
                    Object = rootPart,
                    Text   = label,
                    Color  = color,
                })
                tracked[rootPart] = true
            end

            -- Listen to health changes
            local healthConn = humanoid:GetPropertyChangedSignal("Health"):Connect(updateESP)
            table.insert(conns, healthConn)

            updateESP()
        end

        -- Remove all player ESPs
        local function clearAll()
            for part in pairs(tracked) do
                ESPLibrary:RemoveESP(part)
            end
            tracked = {}
            for _, c in ipairs(conns) do
                c:Disconnect()
            end
            conns = {}
        end

        -- Scan all players
        local function scanAllPlayers()
            clearAll()
            for _, plr in ipairs(Players:GetPlayers()) do
                addPlayer(plr)
            end
        end

        ESPBox:AddToggle(toggleName, {
            Text    = toggleName,
            Default = false,
            Callback = function(on)
                if on then
                    scanAllPlayers()
                    table.insert(conns, Players.PlayerAdded:Connect(scanAllPlayers))
                    table.insert(conns, Players.PlayerRemoving:Connect(scanAllPlayers))
                else
                    clearAll()
                end
            end,
        })
    end

    makePlayerESP("PlayersESP",
        function(player, humanoid)
            return player.Name .. " [" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
        end,
        Color3.fromRGB(0, 150, 255)
    )
end

-- ───────────── Items ESP ─────────────
do
    local Items = {
        "Flashlight", "Lockpick", "Vitamins", "Bandage", "StarVial", "StarBottle", "StarJug",
        "Shakelight", "Straplight", "Bulklight", "Battery", "Candle", "Crucifix", "CrucifixWall",
        "Glowsticks", "SkeletonKey", "Candy", "ShieldMini", "ShieldBig", "BandagePack", "BatteryPack",
        "RiftCandle", "LaserPointer", "HolyGrenade", "Shears", "Smoothie", "Cheese", "Bread",
        "AlarmClock", "RiftSmoothie", "GweenSoda", "GlitchCub", "GoldPile","Candy"
    }
    local ItemsSet = {}
    for _, name in ipairs(Items) do
        ItemsSet[name] = true
    end

    local tracked = {}    -- [Instance] = true
    local conns   = {}    -- list for connections

    local function addItem(obj)
        if tracked[obj] then return end
        ESPLibrary:AddESP({
            Object = obj,
            Text   = obj.Name,
            Color  = Color3.fromRGB(255, 215, 0),
        })
        tracked[obj] = true
    end

    local function removeItem(obj)
        if not tracked[obj] then return end
        ESPLibrary:RemoveESP(obj)
        tracked[obj] = nil
    end

    ESPBox:AddToggle("ItemsESP", {
        Text    = "Items ESP",
        Default = false,
        Callback = function(on)
            -- Cleanup previous
            for _, c in ipairs(conns) do c:Disconnect() end
            conns = {}
            for obj in pairs(tracked) do
                removeItem(obj)
            end
            tracked = {}

            if on then
                -- Initial scan in current room (if it exists)
                local room = currentRoom()
                if room then
                    for _, desc in ipairs(room:GetDescendants()) do
                        if ItemsSet[desc.Name] then
                            addItem(desc)
                        end
                    end

                    -- Listen for items added/removed in this room
                    conns[1] = room.DescendantAdded:Connect(function(desc)
                        if ItemsSet[desc.Name] then
                            addItem(desc)
                        end
                    end)
                    conns[2] = room.DescendantRemoving:Connect(function(desc)
                        if tracked[desc] then
                            removeItem(desc)
                        end
                    end)
                end

                -- Update if player changes room
                conns[3] = GameData.LatestRoom:GetPropertyChangedSignal("Value"):Connect(function()
                    -- Clear old tracked and listeners, then repeat process for new room
                    for _, c in ipairs(conns) do c:Disconnect() end
                    conns = {}
                    for obj in pairs(tracked) do
                        removeItem(obj)
                    end
                    tracked = {}

                    local newRoom = currentRoom()
                    if not newRoom then return end
                    for _, desc in ipairs(newRoom:GetDescendants()) do
                        if ItemsSet[desc.Name] then
                            addItem(desc)
                        end
                    end
                    conns[1] = newRoom.DescendantAdded:Connect(function(desc)
                        if ItemsSet[desc.Name] then
                            addItem(desc)
                        end
                    end)
                    conns[2] = newRoom.DescendantRemoving:Connect(function(desc)
                        if tracked[desc] then
                            removeItem(desc)
                        end
                    end)
                end)
            end
        end,
    })
end
