-- Find the PL event/function once
local function findPL()
    local desc = RepStore:GetDescendants()
    for i = 1, #desc do
        local x = desc[i]
        if x.Name == "PL" and (x:IsA("RemoteEvent") or x:IsA("RemoteFunction")) then
            return x
        end
    end
end
local PL = findPL()

-- Optimized parse function
local function parse(pap, hintsContainer)
    local uiChildren = pap.UI:GetChildren()
    local map, order  = {}, {}

    -- Build maps
    for i = 1, #uiChildren do
        local c = uiChildren[i]
        local n = tonumber(c.Name)
        if n then
            local key       = c.ImageRectOffset.X .. "_" .. c.ImageRectOffset.Y
            map[key]        = { n, "" }
            order[n]        = key
        end
    end

    -- Fill in hints
    if hintsContainer then
        local hintKids = hintsContainer:GetChildren()
        for i = 1, #hintKids do
            local ic = hintKids[i]
            if ic.Name == "Icon" then
                local key = ic.ImageRectOffset.X .. "_" .. ic.ImageRectOffset.Y
                local t   = map[key]
                if t then
                    local lbl = ic:FindFirstChildWhichIsA("TextLabel")
                    if lbl then t[2] = lbl.Text end
                end
            end
        end
    end

    -- Build result
    local res = {}
    for i = 1, #order do
        res[i] = map[ order[i] ][2]
    end
    return table.concat(res)
end

-- Connection management helper
 function manageToggle(toggleName, mode)
    local conns = {}
    local function cleanup()
        for _, c in ipairs(conns) do c:Disconnect() end
        conns = {}
    end

    AutoBox:AddToggle(toggleName, {
        Text    = mode == "Fire" and "Auto Library Code" or "Notify Library Code",
        Default = false,
        Tooltip = mode == "Fire"
            and "Automatically sends code to server"
            or "Shows you the code string in a notification",
        Callback = function(enabled)
            cleanup()
            if not enabled then return end

            -- Grab current character & hints
            local char          = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hintsCont     = PlayerGui:FindFirstChild("PermUI")
                                   and PlayerGui.PermUI:FindFirstChild("Hints")

            -- Whenever a paper appears…
            conns[#conns+1] = char.DescendantAdded:Connect(function(child)
                if child.Name == "LibraryHintPaper" or child.Name == "LibraryHintPaperHard" then
                    -- Initial action
                    local function doAction()
                        local code = parse(child, hintsCont)
                        if mode == "Fire" then
                            PL:FireServer(code)
                        else
                            Library:Notify("Code is "..code, 3)
                        end
                    end
                    doAction()

                    -- Watch hints changing under that paper
                    if hintsCont then
                        conns[#conns+1] = hintsCont.DescendantAdding:Connect(function()
                            doAction()
                        end)
                    end
                end
            end)

            -- Clean up when paper is removed
            conns[#conns+1] = char.DescendantRemoving:Connect(function(child)
                if child.Name == "LibraryHintPaper" or child.Name == "LibraryHintPaperHard" then
                    cleanup()
                end
            end)
        end
    })
end

