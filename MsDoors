local function updateBehavior()
	if not AutoRoomsToggle.Value then
		return
	end

	-- If an entity like A-60/A-120 is present, hide first
	if workspace:FindFirstChild("A60") or workspace:FindFirstChild("A-60")
	or workspace:FindFirstChild("A120") or workspace:FindFirstChild("A-120") then
		hiding = true
		computePath(getLockerPart())
	else
		-- Otherwise, make sure we’re not hiding and head to the next door
		if hiding then
			hiding = false
			LocalPlayer.Character:SetAttribute("Hiding", false)
			computePath(getDoorPart())
		end
	end
end

