-- ──────────────── Entity ESP ────────────────
do
    local EntityNames = {
        RushMoving = true, AmbushMoving = true, A60 = true, A120 = true,
        BackdoorRush = true, SallyWindow = true, JeffTheKiller = true,
        GrumbleRig = true, GiggleCeiling = true, Snare = true, FigureRig = true,
        FigureRagdoll = true, BananaPeel = true, SeekMovingNewClone = true,
        SeekMoving = true, GlitchRush = true, Eyes = true, GlitchAmbush = true,
        BackdoorLookman = true,
    }

    local tracked = {}    -- [Model] = true when ESP added
    local connAdd = nil

     function processModel(model)
        if tracked[model] then return end
        if not EntityNames[model.Name] then return end

        -- Ensure it has a Humanoid
        if not model:FindFirstChildOfClass("Humanoid") then
            local hum = Instance.new("Humanoid")
            hum.Parent = model
        end

        -- Ensure it has a PrimaryPart
        if not model.PrimaryPart then
            local part = model:FindFirstChildWhichIsA("BasePart")
            if part then
                model.PrimaryPart = part
            end
        end

        if model.PrimaryPart then
            model.PrimaryPart.Transparency = 0.99
            model.PrimaryPart.Size = model.PrimaryPart.Size * 1.8

            ESPLibrary:AddESP({
                Object = model.PrimaryPart,
                Text   = model.Name,
                Color  = Color3.fromRGB(255, 0, 0),
            })
            tracked[model] = true
        end
    end

    ESPBox:AddToggle("EntityESP", {
        Text    = "Entity ESP",
        Default = false,
        Callback = function(on)
            if on then
                -- Initial scan of existing Models in Workspace
                for _, desc in ipairs(Workspace:GetDescendants()) do
                    if desc:IsA("Model") then
                        processModel(desc)
                    end
                end

                -- Listen for new Models added under Workspace
                connAdd = Workspace.DescendantAdded:Connect(function(desc)
                    if desc:IsA("Model") then
                        processModel(desc)
                    end
                end)
            else
                -- Cleanup: disconnect and remove all ESP
                if connAdd then
                    connAdd:Disconnect()
                    connAdd = nil
                end
                for model in pairs(tracked) do
                    if model.PrimaryPart then
                        ESPLibrary:RemoveESP(model.PrimaryPart)
                    end
                end
                tracked = {}
            end
        end,
    })
end

-- ───────────── Improved makeRoomESP ─────────────
-- Takes: toggleName (string), matchFn(obj)→bool, label (string or function), color (Color3)
local function makeRoomESP(toggleName, matchFn, label, color)
    -- State per-ESP toggle:
    local tracked       = {}        -- [Instance] = true
    local roomConnAdd   = nil       -- Connection for DescendantAdded of current room
    local roomConnRem   = nil       -- Connection for DescendantRemoving of current room
    local roomChangeConn= nil       -- Connection for GameData.LatestRoom.Value changes

    -- Helper to add ESP on a matching instance
    local function addESP(obj)
        if tracked[obj] then return end
        local target = nil

        -- If Model named "Door", use its PrimaryPart; else use the object itself
        if obj.Name == "Door" and obj:IsA("Model") then
            target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        else
            target = (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Attachment")) and obj or nil
            if not target and obj:IsA("Model") then
                target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end
        end

        if not target then return end

        -- Compute the text label
        local textLabel = ""
        if type(label) == "function" then
            textLabel = label(obj)
        else
            textLabel = label
        end

        ESPLibrary:AddESP({
            Object = target,
            Text   = textLabel,
            Color  = color,
        })
        tracked[obj] = true
    end

    -- Helper to remove ESP from a previously tracked instance
    local function removeESP(obj)
        if not tracked[obj] then return end

        local target = nil
        if obj.Name == "Door" and obj:IsA("Model") then
            target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        else
            target = (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Attachment")) and obj or nil
            if not target and obj:IsA("Model") then
                target = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end
        end

        if target then
            ESPLibrary:RemoveESP(target)
        end
        tracked[obj] = nil
    end

    -- Scan the entire current room once
    local function scanRoom(room)
        if not room then return end
        for _, desc in ipairs(room:GetDescendants()) do
            if matchFn(desc) then
                addESP(desc)
            end
        end
    end

    -- Disconnect any existing room-specific connections & clear ESP
    local function clearRoomConnections()
        if roomConnAdd then
            roomConnAdd:Disconnect()
            roomConnAdd = nil
        end
        if roomConnRem then
            roomConnRem:Disconnect()
            roomConnRem = nil
        end
        for obj in pairs(tracked) do
            removeESP(obj)
        end
        tracked = {}
    end

    -- Called whenever the player changes rooms (GameData.LatestRoom.Value changes)
    local function onRoomChanged()
        -- First, disconnect old room listeners and clear ESP
        clearRoomConnections()

        -- Get new room
        local room = currentRoom()
        if not room then return end

        -- Scan the new room
        scanRoom(room)

        -- Connect incremental listeners on the new room
        roomConnAdd = room.DescendantAdded:Connect(function(desc)
            if matchFn(desc) then
                addESP(desc)
            end
        end)
        roomConnRem = room.DescendantRemoving:Connect(function(desc)
            if tracked[desc] then
                removeESP(desc)
            end
        end)
    end

    -- Create the toggle in ESPBox
    ESPBox:AddToggle(toggleName, {
        Text    = toggleName,
        Default = false,
        Callback = function(on)
            if on then
                -- First-time setup: listen for room changes
                roomChangeConn = GameData.LatestRoom:GetPropertyChangedSignal("Value"):Connect(onRoomChanged)
                -- Run immediately for the current room
                onRoomChanged()
            else
                -- Disable: disconnect listeners and clear ESP
                if roomChangeConn then
                    roomChangeConn:Disconnect()
                    roomChangeConn = nil
                end
                clearRoomConnections()
            end
        end,
    })
end

