 combinedCF   = rotCF * offsetCF
local charCon, headConn
local transparencyConns = {}
local conn
-- helper to lock LocalTransparencyModifier on a BasePart
local function lockTransparency(part, value)
    part.LocalTransparencyModifier = value
     conn = part:GetPropertyChangedSignal("LocalTransparencyModifier")
        :Connect(function() part.LocalTransparencyModifier = value end)
    transparencyConns[#transparencyConns+1] = conn
end

-- bind transparency to head + accessories
 function bindTransparency(character, value)
    for i = 1, #transparencyConns do
        transparencyConns[i]:Disconnect()
    end
    transparencyConns = {}

     children = character:GetChildren()
    for i = 1, #children do
        local c = children[i]
        if c:IsA("Accessory") then
            lockTransparency(c.Handle, value)
        elseif c.Name == "Head" then
            lockTransparency(c, value)
        end
    end
end

-- camera update function
 function updateCamera()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        cam.CFrame = LocalPlayer.Character.Head.CFrame * combinedCF
    end
end

-- handle character spawn
local function onCharacterAdded(char)
    bindTransparency(char, 0)
    -- disconnect old headConn
    if headConn then headConn:Disconnect() headConn = nil end
    -- event-driven camera: update when head moves
     head = char:WaitForChild("Head", 5)
    headConn = head:GetPropertyChangedSignal("CFrame"):Connect(updateCamera)
    -- initial update
    updateCamera()
end

