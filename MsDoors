local function buildForRoom(roomModel)
    for _, c in ipairs(env.promptConns) do c:Disconnect() end
    table.clear(env.promptConns)
    table.clear(env.prompts)

    local function onDescendant(desc)
        if desc:IsA("ProximityPrompt") and isValidPrompt(desc) then
            env.prompts[desc] = { part = getPromptPart(desc), count = 0 }
        end
    end

    for _, desc in ipairs(roomModel:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and isValidPrompt(desc) then
            env.prompts[desc] = { part = getPromptPart(desc), count = 0 }
        end
    end

    table.insert(env.promptConns, roomModel.DescendantAdded:Connect(onDescendant))
end

