                if crouch then crouch:Destroy() end
                clonedCollision.Massless = true
                clonedCollision.Parent = collision.Parent
                speedBypassActive = true
                spawn(function()
                    while speedBypassActive do
                        if clonedCollision then
                            clonedCollision.Massless = true
                            task.wait(0.2)
                            clonedCollision.Massless = false
                            task.wait(0.2)
                        else
                            break
                        end
                    end
                end)
            end
        else
            speedBypassActive = false
            if clonedCollision then
                clonedCollision:Destroy()
                clonedCollision = nil
            end
        end
    end,
})

