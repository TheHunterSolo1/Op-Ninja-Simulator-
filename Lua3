-- Auto Interact Toggle: Find closest ProximityPrompt and fire it using fireproximityprompt
local autoInteractCon
local AutoInteractToggle = Main_Tab:CreateToggle({
    Name = "Auto Interact",
    CurrentValue = false,
    Flag = "AutoInteract",
    Callback = function(enabled)
        if enabled then
            autoInteractCon = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local hrpPos = char.HumanoidRootPart.Position
                local closestPrompt, closestDist = nil, math.huge
                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and not string.find(prompt.Name, "Hide") then
                        local parentPart = prompt.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            local dist = (parentPart.Position - hrpPos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closestPrompt = prompt
                            end
                        end
                    end
                end
                if closestPrompt then
                    pcall(function()
                        fireproximityprompt(closestPrompt)
                    end)
                end
            end)
        else
            if autoInteractCon then
                autoInteractCon:Disconnect()
                autoInteractCon = nil
            end
        end
    end,
})

-- Auto Doors Toggle: Use PathfindingService to move towards a target.
local autoDoorsCon
local AutoDoorsToggle = Main_Tab:CreateToggle({
    Name = "Auto Doors",
    CurrentValue = false,
    Flag = "AutoDoors",
    Callback = function(enabled)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then return end
        if enabled then
            autoDoorsCon = RunService.Heartbeat:Connect(function()
                local targetPos = nil
                -- Try KeyObtain first
                for _, model in pairs(Workspace.CurrentRooms:GetDescendants()) do
                    if model.Name == "KeyObtain" and model:IsA("Model") then
                        local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                        if part then
                            targetPos = part.Position
                            break
                        end
                    end
                end
                -- If not, try Door
                if not targetPos then
                    for _, model in pairs(Workspace.CurrentRooms:GetDescendants()) do
                        if model.Name == "Door" and model:IsA("Model") then
                            local part = model:FindFirstChild("Door")
                            if part then
                                targetPos = part.Position
                                break
                            end
                        end
                    end
                end
                if targetPos then
                    hum.JumpPower = 0  -- disable jumping while pathing
                    local path = PathfindingService:CreatePath({
                        AgentRadius = agentRadius,
                        AgentHeight = 5,
                        AgentCanJump = false
                    })
                    path:ComputeAsync(hrp.Position, targetPos)
                    if path.Status == Enum.PathStatus.Success then
                        local waypoints = path:GetWaypoints()
                        for i, wp in ipairs(waypoints) do
                            local tween = TweenService:Create(hrp, TweenInfo.new(waypointsSpacing, Enum.EasingStyle.Linear), {CFrame = CFrame.new(wp.Position)})
                            tween:Play()
                            tween.Completed:Wait()
                        end
                    else
                        if not autoDoorsNotified then
                            Rayfield:Notify({
                                Title = "Auto Doors",
                                Content = "Path not found!",
                                Duration = 5,
                                Image = nil
                            })
                            autoDoorsNotified = true
                            task.delay(10, function() autoDoorsNotified = false end)
                        end
                    end
                    hum.JumpPower = 50 -- restore jump power
                end
            end)
        else
            if autoDoorsCon then
                autoDoorsCon:Disconnect()
                autoDoorsCon = nil
            end
        end
    end,
})

