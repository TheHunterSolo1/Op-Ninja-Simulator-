-- Trace drawing: Draw a line from local player's head to the bottom of target (if Drawing is available)
local function createTrace(targetPart, color)
    if not drawingAvailable then return nil end
    local line = Drawing.new("Line")
    line.Color = color
    line.Thickness = 0.5
    line.Transparency = 0.5
    line.Visible = true
    return line
end

local function updateTrace(line, targetPart)
    if not (line and targetPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")) then return end
    local headPos = Camera:WorldToViewportPoint(LocalPlayer.Character.Head.Position)
    local targetPos = Camera:WorldToViewportPoint(targetPart.Position - Vector3.new(0, targetPart.Size.Y/2, 0))
    line.From = Vector2.new(headPos.X, headPos.Y)
    line.To = Vector2.new(targetPos.X, targetPos.Y)
end

local function removeTrace(line)
    if line then line:Remove() end
end

-- ESP helper: Add a small BillboardGui and Highlight to a BasePart
local function addESP(part, labelText, color, size)
    if part and part:IsA("BasePart") then
        if not part:FindFirstChild("ESPBillboard") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ESPBillboard"
            bb.Adornee = part
            bb.Size = UDim2.new(0, size or 40, 0, (size and size * 0.5) or 20)
            bb.StudsOffset = Vector3.new(0, 1.5, 0)
            bb.AlwaysOnTop = true
            local label = Instance.new("TextLabel", bb)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = labelText
            label.TextColor3 = color
            label.TextScaled = true
            label.Font = Enum.Font.SourceSans
            bb.Parent = part
        end
        if not part:FindFirstChild("Highlight") then
            local hl = Instance.new("Highlight", part)
            hl.FillColor = color
            hl.Enabled = true
        end
    end
end

local function removeESP(part)
    if part then
        local bb = part:FindFirstChild("ESPBillboard")
        if bb then bb:Destroy() end
        local hl = part:FindFirstChild("Highlight")
        if hl then hl:Destroy() end
    end
end

