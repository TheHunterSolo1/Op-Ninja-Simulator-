-- Speed Bypass Toggle: Clone "Collision" part and toggle its Massless property every 0.2 sec
local SpeedBypassToggle = Main_Tab:CreateToggle({
    Name = "Speed Bypass",
    CurrentValue = false,
    Flag = "SpeedBypass",
    Callback = function(enabled)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
