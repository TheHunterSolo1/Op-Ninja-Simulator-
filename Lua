    -- Smooth Teleport helper (for Auto Farm Honor)
    local function smoothTeleportTo(part, targetCFrame)
        if not part then return end
        local startCFrame = part.CFrame
        local elapsed = 0
        while elapsed < teleportSpeed do
            local alpha = elapsed / teleportSpeed
            part.CFrame = startCFrame:Lerp(targetCFrame, alpha)
            elapsed = elapsed + rs.RenderStepped:Wait()
        end
        part.CFrame = targetCFrame
    end

    -- Improved enemy selection for Auto Farm Honor
    local function getBestEnemy()
        local bestTarget, bestHealth, bestDistance = nil, math.huge, math.huge
        local myChar = lp.Character
        if not myChar then return nil end
        local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHumanoid or not myHRP then return nil end
        local myHealth = myHumanoid.Health

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Team ~= lp.Team and player.Character then
                local enemyHRP = player.Character:FindFirstChild("HumanoidRootPart")
                local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if enemyHRP and enemyHumanoid and enemyHumanoid.Health > 0 then
                    local distance = (myHRP.Position - enemyHRP.Position).Magnitude
                    if farmMode == "Closest Player" then
                        if distance < bestDistance then
                            bestDistance = distance
                            bestTarget = player
                        end
                    elseif farmMode == "Lowest Health" then
                        local enemyHealth = enemyHumanoid.Health
                        if enemyHealth < bestHealth or (enemyHealth >= myHealth and bestHealth >= myHealth) then
                            bestHealth = enemyHealth
                            bestDistance = distance
                            bestTarget = player
                        end
                    end
                end
            end
        end
        return bestTarget
    end

    -- Auto Farm Honor Toggle
    FarmTab:CreateToggle({
        Name = "Auto Farm Honor",
        CurrentValue = false,
        Flag = "Toggle_AutoFarmHonor",
        Callback = function(enabled)
            local char = lp.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if enabled then
                oldPosition = hrp.Position
                autoFarmHonorCon = rs.RenderStepped:Connect(function()
                    local target = getBestEnemy()
                    if target and target.Character then
                        local enemyHRP = target.Character:FindFirstChild("HumanoidRootPart")
                        if enemyHRP then
                            local targetCFrame = enemyHRP.CFrame * CFrame.new(teleportOffset.X, teleportOffset.Y, teleportOffset.Z)
                            if smoothTeleport then
                                smoothTeleportTo(hrp, targetCFrame)
                            else
                                hrp.CFrame = targetCFrame
                            end
                        end
                    end
                end)
            else
                if autoFarmHonorCon then autoFarmHonorCon:Disconnect() autoFarmHonorCon = nil end
                if oldPosition then
                    if smoothTeleport then
                        smoothTeleportTo(hrp, CFrame.new(oldPosition))
                    else
                        hrp.CFrame = CFrame.new(oldPosition)
                    end
                end
            end
        end,
    })

