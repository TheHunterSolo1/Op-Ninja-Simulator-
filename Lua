    -- Auto Hide Toggle
    FarmTab:CreateToggle({
        Name = "Auto Hide",
        CurrentValue = false,
        Flag = "Toggle_AutoHide",
        Callback = function(enabled)
            local char = lp.Character or lp.CharacterAdded:Wait()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if enabled then
                oldPosition = hrp.Position
                autoHideCon = rs.RenderStepped:Connect(function()
                    local threat = false
                    local myHumanoid = char:FindFirstChildOfClass("Humanoid")
                    if not myHumanoid then return end
                    local myHealth = myHumanoid.Health
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= lp and player.Team ~= lp.Team and player.Character then
                            local enemyHRP = player.Character:FindFirstChild("HumanoidRootPart")
                            local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                            if enemyHRP and enemyHumanoid and enemyHumanoid.Health > myHealth then
                                local enemyPos = enemyHRP.Position
                                local horizDist = (Vector3.new(enemyPos.X, 0, enemyPos.Z) - Vector3.new(oldPosition.X, 0, oldPosition.Z)).Magnitude
                                if horizDist < hideDetectionRange then
                                    threat = true
                                    break
                                end
                            end
                        end
                    end
                    if threat then
                        if not autoHideHiding then
                            autoHideHiding = true
                            if not hrp:FindFirstChild("AutoHideBP") then
                                local bp = Instance.new("BodyPosition")
                                bp.Name = "AutoHideBP"
                                bp.Position = oldPosition + Vector3.new(0, hideHeight, 0)
                                bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                                bp.P = 1e4
                                bp.Parent = hrp
                            end
                        end
                    else
                        if autoHideHiding then
                            autoHideHiding = false
                            if hrp:FindFirstChild("AutoHideBP") then
                                hrp.AutoHideBP:Destroy()
                            end
                            hrp.CFrame = CFrame.new(oldPosition)
                        end
                    end
                end)
            else
                if autoHideCon then autoHideCon:Disconnect() autoHideCon = nil end
                if autoHideHiding and hrp:FindFirstChild("AutoHideBP") then
                    hrp.AutoHideBP:Destroy()
                    autoHideHiding = false
                    hrp.CFrame = CFrame.new(oldPosition)
                end
            end
        end,
    })

